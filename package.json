{
  "name": "cravekeep",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @cravekeep/mobile start",
    "android": "pnpm --filter @cravekeep/mobile android",
    "ios": "pnpm --filter @cravekeep/mobile ios",
    "web": "pnpm --filter @cravekeep/mobile web",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "supabase:link": "supabase link --project-ref ymenpwsrmdnnwsykoayo",
    "supabase:push": "supabase db push"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "supabase": "^2.113.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.14"
  }
}
